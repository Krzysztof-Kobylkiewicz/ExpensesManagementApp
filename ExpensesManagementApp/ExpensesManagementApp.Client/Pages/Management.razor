@page "/management"
@page "/"
@rendermode InteractiveAuto
@using Models.Statistics
@using Services
@using ExpensesManagementApp.Client.Services.StatisticsService
@using ExpensesManagementApp.Client.Services.TransactionService
@inject IStatisticsService statisticsService
@inject ITransactionService transactionService

<PageTitle>Management</PageTitle>

<MudPaper Class="mt-5 pa-5">
    <MudExpansionPanel Text="Statistics filter" Expanded="true">
        <MudGrid>
            <MudItem md="3" xs="12">
                <MudTooltip Text="@(!filter.IsRangeEditable() ? "To unlock date range picker please choose 'other' period": string.Empty)">
                    <MudDateRangePicker Label="Transactions range" DateRange="ChooseDateRangeForPicker()" DateRangeChanged="(dr) => {filter.DateTimeFrom = dr.Start; filter.DateTimeTo = dr.End;}" Disabled="!filter.IsRangeEditable()" />
                </MudTooltip>
            </MudItem>
            <MudItem md="2" xs="12">
                <MudSelect T="ExpensesManagementApp.Models.Statistics.PeriodEnum?" Value="filter.Period" ValueChanged="(v) => filter.Period = v" Label="@DisplayHelper.DisplayName(() => filter.Period)">
                    @foreach (var period in Enum.GetValues<ExpensesManagementApp.Models.Statistics.PeriodEnum>())
                    {
                        <MudSelectItem T="ExpensesManagementApp.Models.Statistics.PeriodEnum?" Value="period">@ExpensesManagementApp.Models.Statistics.Statistics.PeriodEnumToString(period)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem md="12" xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                    <MudButton Size="Size.Medium" Variant="Variant.Filled" OnClick="async () => await GetStatisticsPackageAsync()">Search</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudPaper>

<MudPaper Class="mt-5 pa-5">
    <MudGrid>

        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.Sum.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.Average))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.IncomeSum.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.IncomeSum))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.ExpensesSum.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.ExpensesSum))" />
        </MudItem>

        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.Average.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.Average))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.IncomeAverage.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.IncomeAverage))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.ExpensesAverage.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.ExpensesAverage))" />
        </MudItem>

        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.Median.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.Median))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.IncomeMedian.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.IncomeMedian))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.ExpensesMedian.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.ExpensesMedian))" />
        </MudItem>

        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.Dominant.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.Dominant))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.IncomeDominant.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.IncomeDominant))" />
        </MudItem>
        <MudItem md="2" xs="12">
            <MudTextField T="string" Text="@_statistics.ExpensesDominant.ToString()" Label="@(DisplayHelper.DisplayName(() => _statistics.ExpensesDominant))" />
        </MudItem>

        @if (_transactionsChartSeries != null && _statisticsPackage != null && _statisticsPackage.LatestTransactionDate.HasValue)
        {
            <MudItem md="12" xs="12" Class="pa-10">
                <MudChart @ref="_mudChart" Class="pa-10" ChartType="ChartType.Bar" ChartSeries="_series" @bind-SelectedIndex="_transactionsChartSeries.Index" XAxisLabels="TransactionsChartSeries.ChooseXAxisLabels(filter, _statisticsPackage.LatestTransactionDate.Value)" ChartOptions="@(new ChartOptions { ChartPalette = _transactionsChartSeries.BarColors() ?? TransactionsChartSeries.DefaultColors, YAxisTicks = 1, ShowToolTips = true })" />
            </MudItem>
        }

    </MudGrid>
</MudPaper>

@code {

    private Models.Transaction.TransactionFilter filter { get; set; } = new();

    private StatisticsPackage? _statisticsPackage { get; set; }

    private Statistics _statistics => _statisticsPackage?.Statistics ?? new Statistics();

    private TransactionsChartSeries? _transactionsChartSeries => _statisticsPackage?.TransactionsChartSeries;

    private List<ChartSeries> _series => _statisticsPackage?.TransactionsChartSeries?.ChartSeries ?? [];

    private MudChart? _mudChart;

    protected async override Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await GetStatisticsPackageAsync();
    }

    private async Task GetStatisticsPackageAsync()
    {
        var _httpResult = await statisticsService.GetStatisticsPackageAsync(filter);

        if (_httpResult.Data != null)
        {
            _statisticsPackage = _httpResult.Data;
            //_chartOptions.ChartPalette = _transactionsChartSeries?.BarColors() ?? TransactionsChartSeries.DefaultColors;
        }
    }

    private DateRange ChooseDateRangeForPicker() => filter.Period.Equals(PeriodEnum.Other) ? new DateRange() : _statisticsPackage?.PackageTransactionsDateRange() ?? new DateRange();
}
